# Database Configuration
DATABASE_URL="postgresql://username:password@host:port/database?sslmode=require"

# NextAuth Authentication Config
# Generate a secret via: openssl rand -base64 33
AUTH_SECRET="your-next-auth-secret-here"
AUTH_GOOGLE_ID="your-google-oauth-client-id-here"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret-here"

# Admin Configuration
ADMIN_EMAIL="muhamadaibayu@gmail.com"
# Secret token key to authorize admin broadcasts to PartyKit server
ADMIN_BROADCAST_SECRET="your-admin-broadcast-secret-token-here"

# PartyKit Server Config (WebSocket)
# Local: localhost:1999, Production: your-project-name.username.partykit.dev
NEXT_PUBLIC_PARTYKIT_HOST="tumpuk-party-bayy.bayy-kim.partykit.dev"

# Public site domain URL (Next.js host url, used in PartyKit backend server to save matches)
# Local: http://localhost:3000, Production: https://tumpuk.vercel.app
NEXT_PUBLIC_SITE_URL="https://tumpuk.vercel.app"

# Supabase Storage Configuration (Optional/Fallback)
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-url.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"
