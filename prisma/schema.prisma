generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id          String        @id @default(uuid())
  name        String
  avatarUrl   String?
  email       String?       @unique
  provider    String
  role        Role          @default(USER)
  createdAt   DateTime      @default(now())
  wonMatches  Match[]       @relation("WonMatches")
  matches     MatchPlayer[]
  hostedRooms Room[]        @relation("HostedRooms")
}

model Room {
  id         String     @id @default(uuid())
  code       String     @unique
  hostUserId String
  status     RoomStatus @default(WAITING)
  houseRules Json
  maxPlayers Int        @default(6)
  createdAt  DateTime   @default(now())
  matches    Match[]
  host       User       @relation("HostedRooms", fields: [hostUserId], references: [id])
}

model Match {
  id        String        @id @default(uuid())
  roomId    String
  winnerId  String?
  startedAt DateTime      @default(now())
  endedAt   DateTime?
  room      Room          @relation(fields: [roomId], references: [id])
  winner    User?         @relation("WonMatches", fields: [winnerId], references: [id])
  players   MatchPlayer[]
}

model MatchPlayer {
  id            String  @id @default(uuid())
  matchId       String
  userId        String?
  guestName     String?
  finalHandSize Int
  scoreDelta    Int
  seatIndex     Int
  match         Match   @relation(fields: [matchId], references: [id])
  user          User?   @relation(fields: [userId], references: [id])
}

enum RoomStatus {
  WAITING
  PLAYING
  FINISHED
}
